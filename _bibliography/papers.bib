@article{AM115,
  title={An Optimal Control Analysis of San Francisco's Muni Light Rail},
  author={Kaylee Vo},
  abstract={In this paper, we formulate and solve an optimal control problem for San Francisco's Muni Metro light rail. Our problem models the acceleration and braking as a single control, optimizing for energy cost, brake wear, and smoothness of the control function. We present solutions for two cases: time as an independent variable and time as a dependent variable. For the former case, we find the optimal control function to move a light rail to a predefined end position and end time. This scenario covers most Muni travel cases since light rails adhere to a strict timetable and the distance between stations is fixed. Our simulated routes include those that are straight, curved, and have grades. We then modify the model to make time the dependent variable to account for the situation where a light rail approaches a terminal station, with no train blocking the station ahead. We conclude with a sensitivity analysis on uncertain parameters and robustness checks using varying grade profiles.},
  journal={Mathematical Modeling},
  location={Cambridge, MA},
  year={2025},
  month={August},
  publisher={Harvard University},
  code={https://github.com/kayleeisokay/AM115_Final_Project},
  pdf={AM115_3.pdf},
  dimensions={true},
  selected={true},
  preview={optimal_trajectory_hill.gif},
}

@article{AM115,
  title={Analysis of Airport Security with Queuing Theory},
  author={Kaylee Vo},
  abstract={This paper presents two queuing models to simulate airport security gates while accounting for two types of passengers: PreCheck and regular. We use public data from the Transportation Security Administration (TSA) to estimate model parameters. For cases with no data, we back out parameter values using Erlang's C formula and Little's Law. Our first model is an M/M/c queue with pooled servers and a priority queue. Using the M/M/c model, we present the airport security's total cost function and find optimal service rates and number of servers (µ and c, respectively). We then relax the distributional assumptions of the M/M/c model to build an M/N/c model to simulate results. Using the M/N/c model, we model cost from the passenger perspective, finding the optimal PreCheck price based on the average wait time. We conclude with a sensitivity analysis of our results to the most important parameters.},
  journal={Mathematical Modeling},
  location={Cambridge, MA},
  year={2025},
  month={July},
  publisher={Harvard University},
  code={https://github.com/kayleeisokay/AM115_HW/blob/main/Group%20Project%202/Airport_Queuing_Model_Code.ipynb},
  pdf={AM115_2.pdf},
  dimensions={true},
  selected={false},
  preview={AM115_2.gif},
  annotation={* includes Tadhg Scannell},
}

@article{AM115,
  title={The Economic Effect of COVID Lockdown Policies},
  author={Kaylee Vo},
  abstract={This paper presents a mathematical model of the COVID-19 pandemic. We extend the standard SIR model by including two new states, exposed (E) and death (D), denoting this model as the SEIRD model. The model also includes additional transition edges for vaccination and virus mutation. We augment the model dynamics with a COVID lockdown function, parameterized by s and m. The parameter s controls the speed of a lockdown, and m controls the strength. We then present a total cost objective function that balances total deaths, economic cost, and a hospital over-capacity penalty. We follow by modifying the economic cost to account for individual-specific productivity levels. We present the optimal lockdown parameter set and conduct a sensitivity analysis for the most important parameters.},
  journal={Mathematical Modeling},
  location={Cambridge, MA},
  year={2025},
  month={June},
  publisher={Harvard University},
  code={https://github.com/kayleeisokay/AM115_HW/blob/main/Group%20Project%201/epidemic_model_code.ipynb},
  pdf={AM115_1.pdf},
  dimensions={true},
  selected={false},
  preview={AM115_1.gif},
  annotation={* includes Tadhg Scannell},
}


@article{cs109b,
  title={Classification of Human Emotions},
  author={Kaylee Vo},
  abstract={FER-2013 is a dataset of facial expressions that contains 35,887 grayscale images of faces with seven different emotions: anger, disgust, fear, happiness, sadness, surprise, and neutral. In this project, we explore various different approaches to classifying emotions, custom convolutional neural networks (CNNs), transfer learning and vision transformers. Prior work on this dataset without an auxiliary dataset ranges from 70-75% accuracy, where human classification accuracy is benchmarked between 60 and 70%. Most relied heavily on CNNs but in this project we also tested vision transformers. We use an autoencoder to filter out outlying images based on reconstruction data. Using this filtered dataset, our custom U-Net model with squeeze-excite blocks achieves a test accuracy of 64%, matching human benchmarks. Our most performant model is transfer learning with a ResNet50 model, which achieves a test accuracy of 68.5%, comparable to other papers. Other papers have found higher accuracies in the range of 73-78% but these were done with an auxiliary dataset or with a multi-label setup. Although novel, the vision transformer did not perform well, only marginally better than random. This is most likely due to the small sample size, since models with weaker inductive biases need more data to learn.},
  journal={Advanced Topics in Data Science},
  location={Cambridge, MA},
  year={2025},
  month={May},
  publisher={Harvard University},
  code={http://github.com/kayleeisokay/cs109b-final-project},
  html={MS5.html},
  pdf={MS5_109b.pdf},
  dimensions={true},
  selected={true},
  preview={109b.gif},
  annotation={* includes Santiago Becerra, Sarah Kim, Chloe Seo, Jie Zhao},
}

@article{e116,
  title={Super Restore - A Time Series Analysis of Runescape's Most Popular Potion},
  author={Kaylee Vo},
  abstract={Runescape is a widely popular massively multiplayer online game (MMO) peaking in popularity in the early 2000's. For its level of popularity, little empirical research has been conducted on the economics of the game's Grand Exchange (GE). In this work, we analyze the economic dynamics of Super Restore, one of the game's most popular potions. We apply time series models to determine whether the GE behaves similarly to real-world exchanges. We construct a DAG for Super Restore's value chain and use regression models to estimate the edges from input good to output good. In doing so, we also show that there is no evidence of a wealth effect in Runescape's virtual prices. We then use a vector error correction model (VECM), combined with structural breaks, to show evidence of a substitution relationship between Prayer Potions and Super Restore. We further support this claim by estimating the impulse response functions using vector autoregression (VAR), including all items in the value chain as endogenous variables. We then explore a wide gamut of models to determine the model that best forecasts Super Restore prices. We show that a long short-term memory neural network (LSTM) with two hidden layers outperforms all other models in predicting Super Restore prices. Finally, we conclude by recommending ARIMA as the optimal model due to its simplicity and close performance to LSTM.},
  journal={Time Series Analysis},
  location={Cambridge, MA},
  year={2024},
  month={Dec},
  pdf={E-116_Report.pdf},
  code={https://github.com/kayleeisokay/e-116/tree/main/submission},
  html={MS5.html},
  publisher={Harvard University},
  dimensions={true},
  selected={false},
  preview={vecm_plot.png},
}

@article{cs109a,
  title={Telecom Churn: Prediction and Causal Inference },
  author={Kaylee Vo},
  abstract={Customer churn is a ubiquitous business problem across multiple industries, especially serviced-based industries, which rely on recurring revenue. In this project, we focus on customer churn as it relates to the telecoms industry. The aim is to develop a model that adequately captures the data generating process of customer churn and is able to provide robust prediction estimates of the binary label. Furthermore, we extend our analysis to include a causal inference study on how a given exogenous feature affects churn. The data is the Cell2Cell data provided by the Teradata Center for Customer Relationship Management at Duke University. The data is a cross sectional, customer-level dataset. Using the data we were able to develop a RandomForest model that predicts customer churn with an evenly weighted f1-score of 0.60 and an AUC of 0.65. Prior studies have hovered around an AUC of 0.62, therefore our model is a marked improvement. Our causal inference study found that ATE of "call to retention center" on churn is positive and significant, a doubling of odds in churn for our IPTW estimate and 0.139 increase in churn rate for our matching estimate. Similarly, the ATE of "responds to mail offers" on churn was negative and significant for our IPTW estimate and matching estimate. The IPTW results suggest a 1.48% decrease in the odds of churn and the matching suggested a 70% decrease in churn rate. The vast difference can be attributed to the fact that the positivity assumption was violated in the IPTW model.},
  journal={Introduction to Data Science},
  location={Cambridge, MA},
  year={2024},
  month={Dec},
  pdf={MS5_109a.pdf},
  code={https://github.com/kayleeisokay/cs109a_final_project},
  html={MS5_109a.html},
  publisher={Harvard University},
  dimensions={true},
  selected={false},
  annotation={* includes Sirisom Pranivong, Chloe Seo, Kai Yeh},
  preview={auc_109a.png},
}
